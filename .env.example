# Copy to .env (git-ignored) for the local prod-like stack (compose.yaml).
# scripts/local-prod.ps1 creates .env automatically with a random SA password if it's missing.

# SQL Server policy: at least 8 chars with upper, lower, digit and symbol. No quotes.
MSSQL_SA_PASSWORD=
# Optional until FR-005 lands; leave empty and the app logs a warning.
ANTHROPIC_API_KEY=

# Playwright E2E test user (local LocalDB only; see context/foundation/test-stack.md, ## E2E).
E2E_USERNAME=
E2E_PASSWORD=
# Second test user, for specs that need two accounts (risk #4).
E2E_USERNAME_B=
E2E_PASSWORD_B=

# Post-deploy smoke (npm run smoke; see context/foundation/test-stack.md, ## Smoke).
# SMOKE_BASE_URL is http://localhost:8090 for the local prod-like stack. The smoke spends one real AI call per run.
SMOKE_BASE_URL=
SMOKE_USERNAME=
SMOKE_PASSWORD=
# Set to 1 to let the smoke register its account when sign-in fails (a fresh database, e.g. local-prod -Reset).
SMOKE_ALLOW_REGISTER=
