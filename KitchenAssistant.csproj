<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-KitchenAssistant-40efb3c6-1e5b-4980-8207-342f929eb801</UserSecretsId>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Image name for `dotnet publish /t:PublishContainer` (local prod-like stack, see compose.yaml). -->
    <ContainerRepository>kitchen-assistant</ContainerRepository>
    <!-- The test project sits inside this project's folder; keep its sources out of the app's default globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);KitchenAssistant.Tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.50.0" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the tests build the AI response DTOs (Recipes/RecipeResponseParser.cs) directly. -->
    <InternalsVisibleTo Include="KitchenAssistant.Tests" />
  </ItemGroup>

</Project>
