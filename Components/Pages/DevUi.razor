@page "/dev/ui"

@using System.ComponentModel.DataAnnotations
@using KitchenAssistant.Components.Account
@using KitchenAssistant.Components.Account.Shared
@using KitchenAssistant.Data
@using KitchenAssistant.Recipes

@inject IWebHostEnvironment Environment
@inject NavigationManager NavigationManager

@if (isDevelopment)
{
    <PageTitle>Dev UI</PageTitle>

    <h1>Dev UI</h1>
    <p class="text-body-secondary">Development-only kitchen sink: every shared component in every state.</p>

    <section class="mb-4">
        <h2>FormField: default</h2>
        <FormField TValue="string" Id="dev-default" Label="Nazwa">
            <input id="dev-default" type="text" class="form-control" value="Marchewka" />
        </FormField>
    </section>

    <section class="mb-4">
        <h2>FormField: read-only</h2>
        <FormField TValue="string" Id="dev-readonly" Label="E-mail">
            <input id="dev-readonly" type="email" class="form-control-plaintext" value="jan@example.com" readonly />
        </FormField>
    </section>

    <section class="mb-4">
        <h2>FormField: disabled</h2>
        <FormField TValue="string" Id="dev-disabled" Label="Nazwa">
            <input id="dev-disabled" type="text" class="form-control" value="Marchewka" disabled />
        </FormField>
    </section>

    <section class="mb-4">
        <h2>FormField: error</h2>
        <EditForm EditContext="errorContext">
            <FormField Id="dev-error" Label="Nazwa" For="() => errorModel.Name">
                <InputText id="dev-error" class="form-control" @bind-Value="errorModel.Name" />
            </FormField>
        </EditForm>
    </section>

    <section class="mb-4">
        <h2>Buttons</h2>
        <button type="button" class="btn btn-primary me-2">Dodaj</button>
        <button type="button" class="btn btn-primary" disabled>Dodaj</button>
    </section>

    <section class="mb-4">
        <h2>SegmentedControl</h2>
        @* Static SSR: the states render, but clicking an option changes nothing on the server. *@
        <h3 class="h6">Default, first option selected</h3>
        <SegmentedControl TValue="MealType" Name="dev-meal-type" Legend="Rodzaj posiłku"
                          Options="MealLabels.MealTypeChoices" Value="MealType.Breakfast" />
        <h3 class="h6">Non-first option selected</h3>
        <SegmentedControl TValue="int?" Name="dev-max-prep" Legend="Maksymalny czas przygotowania"
                          Options="MealLabels.MaxPrepTimeChoices" Value="null" />
        <h3 class="h6">Disabled</h3>
        <SegmentedControl TValue="int" Name="dev-servings" Legend="Liczba porcji"
                          Options="MealLabels.ServingsChoices" Value="2" Disabled="true" />
    </section>

    <section class="mb-4">
        <h2>StatusMessage</h2>
        <StatusMessage Kind="StatusKind.Success" Message="Twój profil został zaktualizowany." />
        <StatusMessage Kind="StatusKind.Error" Message="Nie udało się zapisać zmian. Spróbuj ponownie." />
        <StatusMessage Message="Error: komunikat bez rodzaju powinien być czerwony." />
    </section>

    <section class="mb-4">
        <h2>RecipeScoreSummary</h2>
        <h3 class="h6">0 missing, 2 use-first</h3>
        <RecipeScoreSummary Score="new RecipeScore(5, 5, 0, 2)" />
        <h3 class="h6">1 missing, 1 use-first</h3>
        <RecipeScoreSummary Score="new RecipeScore(3, 4, 1, 1)" />
        <h3 class="h6">2 missing, 0 use-first</h3>
        <RecipeScoreSummary Score="new RecipeScore(2, 4, 2, 0)" />
        <h3 class="h6">Y = 1 (singular)</h3>
        <RecipeScoreSummary Score="new RecipeScore(1, 1, 0, 0)" />
    </section>

    <section class="mb-4">
        <h2>IngredientStatusBadge</h2>
        <ul class="list-group">
            <li class="list-group-item">Owned <IngredientStatusBadge Status="IngredientStatus.Owned" /></li>
            <li class="list-group-item">AlwaysAtHome <IngredientStatusBadge Status="IngredientStatus.AlwaysAtHome" /></li>
            <li class="list-group-item">Missing <IngredientStatusBadge Status="IngredientStatus.Missing" /></li>
        </ul>
    </section>

    <section class="mb-4">
        <h2>RecipeCard</h2>
        <h3 class="h6">Collapsed, with missing ingredients</h3>
        <RecipeCard Proposal="collapsedWithMissing" />
        <h3 class="h6">Collapsed, nothing missing, no summary or prep time</h3>
        <RecipeCard Proposal="collapsedNothingMissing" />
        <h3 class="h6">Expanded, owned + always-at-home + missing</h3>
        <RecipeCard Proposal="expandedMixed" InitiallyExpanded="true" />
    </section>

    <section class="mb-4">
        <h2>ManageNavMenu</h2>
        <ManageNavMenu />
    </section>
}

@code {
    private bool isDevelopment;
    private readonly ErrorModel errorModel = new();
    private EditContext errorContext = default!;

    private static readonly RecipeProposal collapsedWithMissing = Proposal(
        "Omlet ze szpinakiem",
        "Puszysty omlet z młodym szpinakiem i serem.",
        15,
        [
            new("szpinak", "100 g", IngredientStatus.Owned, 1, ProductCategory.UseFirst),
            new("jajka", "3 szt.", IngredientStatus.Missing, null, null),
            new("ser feta", "50 g", IngredientStatus.Missing, null, null),
            new("sól", null, IngredientStatus.AlwaysAtHome, null, null),
        ],
        ["Roztrzep jajka z solą.", "Podsmaż szpinak.", "Wlej jajka, dodaj fetę i smaż pod przykryciem."]);

    private static readonly RecipeProposal collapsedNothingMissing = Proposal(
        "Kanapki z twarożkiem",
        null,
        null,
        [
            new("chleb", "4 kromki", IngredientStatus.Owned, 2, ProductCategory.Stored),
            new("twaróg", "200 g", IngredientStatus.Owned, 3, ProductCategory.UseFirst),
            new("pieprz", null, IngredientStatus.AlwaysAtHome, null, null),
        ],
        ["Wymieszaj twaróg z pieprzem.", "Posmaruj kromki."]);

    private static readonly RecipeProposal expandedMixed = Proposal(
        "Makaron z pomidorami",
        "Szybki obiad z tego, co jest w spiżarni.",
        25,
        [
            new("makaron", "200 g", IngredientStatus.Owned, 4, ProductCategory.Stored),
            new("pomidory", "4 szt.", IngredientStatus.Owned, 5, ProductCategory.UseFirst),
            new("oliwa", "2 łyżki", IngredientStatus.AlwaysAtHome, null, null),
            new("bazylia", "garść", IngredientStatus.Missing, null, null),
        ],
        ["Ugotuj makaron al dente.", "Podsmaż pokrojone pomidory na oliwie.", "Wymieszaj z makaronem i posyp bazylią."]);

    // The score is computed from the ingredients, as RecipeService does, never written by hand.
    private static RecipeProposal Proposal(string title, string? summary, int? prepMinutes, IReadOnlyList<ProposalIngredient> ingredients, IReadOnlyList<string> steps) =>
        new(title, summary, prepMinutes, ingredients, steps, RecipeScore.From(ingredients));

    protected override void OnInitialized()
    {
        if (!Environment.IsDevelopment())
        {
            NavigationManager.NotFound();
            return;
        }

        isDevelopment = true;
        errorContext = new EditContext(errorModel);

        // Validated by hand: no DataAnnotationsValidator is attached yet at this point, so Validate() would be a no-op.
        var store = new ValidationMessageStore(errorContext);
        var results = new List<ValidationResult>();
        Validator.TryValidateObject(errorModel, new ValidationContext(errorModel), results, validateAllProperties: true);
        foreach (var result in results)
        {
            foreach (var member in result.MemberNames)
            {
                store.Add(errorContext.Field(member), result.ErrorMessage ?? string.Empty);
            }
        }
    }

    private sealed class ErrorModel
    {
        [Required(ErrorMessage = "Nazwa jest wymagana.")]
        public string? Name { get; set; }
    }
}
