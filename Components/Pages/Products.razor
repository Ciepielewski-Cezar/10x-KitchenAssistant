@page "/products"
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using KitchenAssistant.Data
@using KitchenAssistant.Pantry

@attribute [Authorize]

@inject ProductService ProductService
@inject ILogger<Products> Logger

<PageTitle>Moje produkty</PageTitle>

<h1>Moje produkty</h1>

<EditForm Model="form" OnValidSubmit="AddAsync" class="mb-4">
    <DataAnnotationsValidator />

    <ProductFields Form="form" IdPrefix="product" @ref="addFields" />

    <button type="submit" class="btn btn-primary" disabled="@saving">Dodaj</button>

    @if (errorMessage is not null)
    {
        <div class="text-danger mt-2" role="alert">@errorMessage</div>
    }
</EditForm>

@if (loadFailed)
{
    <div class="alert alert-danger" role="alert">Nie udało się wczytać produktów.</div>
}
else if (products is not null)
{
    <section class="mb-4">
        <h2>@ProductLabels.For(ProductCategory.UseFirst)</h2>
        @ProductSection(products.UseFirst)
    </section>

    <section class="mb-4">
        <h2>@ProductLabels.For(ProductCategory.Stored)</h2>
        @ProductSection(products.Stored)
    </section>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private ProductForm form = new();
    private ProductList? products;
    private ProductFields? addFields;
    private string? userId;
    private string? errorMessage;
    private bool loadFailed;
    private bool saving;
    private bool focusName;

    // Row state: at most one row is being edited or confirming a delete at a time.
    private int? editingId;
    private ProductForm? editForm;
    private ProductFields? editFields;
    private int? confirmingDeleteId;
    private string? rowErrorMessage;
    private bool savingEdit;
    private bool deleting;
    private bool focusEditName;

    private RenderFragment ProductSection(IReadOnlyList<ProductListItem> items) => __builder =>
    {
        if (items.Count == 0)
        {
            <p class="text-muted">Brak produktów w tej kategorii.</p>
        }
        else
        {
            <ul class="list-group">
                @foreach (var item in items)
                {
                    <li class="list-group-item @(item.IsExpiryDue ? "list-group-item-warning" : null)">
                        @if (editingId == item.Id && editForm is not null)
                        {
                            <EditForm Model="editForm" OnValidSubmit="SaveEditAsync">
                                <DataAnnotationsValidator />

                                <ProductFields Form="editForm" IdPrefix="@($"edit-{item.Id}")" @ref="editFields" />

                                <div class="d-flex flex-wrap gap-2">
                                    <button type="submit" class="btn btn-sm btn-primary" disabled="@savingEdit">Zapisz</button>
                                    <button type="button" class="btn btn-sm btn-link" @onclick="CancelRowAction">Anuluj</button>
                                </div>

                                @if (rowErrorMessage is not null)
                                {
                                    <div class="text-danger mt-2" role="alert">@rowErrorMessage</div>
                                }
                            </EditForm>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <div>
                                    <strong>@item.Name</strong>
                                    @if (item.Quantity is not null)
                                    {
                                        <span class="ms-2">@item.Quantity</span>
                                    }
                                    @if (item.StorageLocation is { } location)
                                    {
                                        <span class="ms-2 text-muted">@ProductLabels.For(location)</span>
                                    }
                                    @if (item.ExpiresOn is { } expiresOn)
                                    {
                                        <span class="ms-2 text-muted">@expiresOn.ToString("dd.MM.yyyy")</span>
                                    }
                                    @if (item.IsExpiryDue)
                                    {
                                        <span class="badge text-bg-warning ms-2">Sprawdź termin</span>
                                    }
                                </div>

                                <div class="ms-auto d-flex flex-wrap align-items-center gap-2">
                                    @if (confirmingDeleteId == item.Id)
                                    {
                                        <span>Usunąć „@item.Name”?</span>
                                        <button type="button" class="btn btn-sm btn-danger" disabled="@deleting" @onclick="DeleteAsync">Usuń</button>
                                        <button type="button" class="btn btn-sm btn-link" @onclick="CancelRowAction">Anuluj</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-link" aria-label="@($"Zmień {item.Name}")" @onclick="() => StartEdit(item)">Zmień</button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" aria-label="@($"Usuń {item.Name}")" @onclick="() => StartDelete(item)">Usuń</button>
                                    }
                                </div>
                            </div>

                            @if (confirmingDeleteId == item.Id && rowErrorMessage is not null)
                            {
                                <div class="text-danger mt-2" role="alert">@rowErrorMessage</div>
                            }
                        }
                    </li>
                }
            </ul>
        }
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask!;
        userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            products = await ProductService.GetProductsAsync(userId!);
            loadFailed = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load products.");
            loadFailed = true;
        }
    }

    private async Task AddAsync()
    {
        // The button is only disabled once the render reaches the browser, so a fast double click can still get here twice.
        if (saving)
        {
            return;
        }

        errorMessage = null;
        saving = true;
        // Captured before the await, because the form may be replaced while the call is in flight.
        var name = form.Name!.Trim();
        var category = form.Category!.Value;
        try
        {
            var result = await ProductService.AddProductAsync(userId!, form);
            if (result == AddProductResult.Duplicate)
            {
                errorMessage = $"Produkt „{name}” jest już w kategorii „{ProductLabels.For(category)}”.";
                return;
            }

            await LoadAsync();
            form = new ProductForm { Category = category };
            focusName = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to add a product.");
            errorMessage = "Nie udało się zapisać produktu. Spróbuj ponownie.";
        }
        finally
        {
            saving = false;
        }
    }

    // Starting an action on one row discards any other row's edit or delete confirmation.
    private void StartEdit(ProductListItem item)
    {
        ClearRowState();
        errorMessage = null;
        editingId = item.Id;
        // A fresh copy, so the edit never shares state with the add form or the listed item.
        editForm = new ProductForm
        {
            Name = item.Name,
            Category = item.Category,
            Quantity = item.Quantity,
            ExpiresOn = item.ExpiresOn,
            StorageLocation = item.StorageLocation,
        };
        focusEditName = true;
    }

    private void StartDelete(ProductListItem item)
    {
        ClearRowState();
        errorMessage = null;
        confirmingDeleteId = item.Id;
    }

    private void CancelRowAction() => ClearRowState();

    private void ClearRowState()
    {
        editingId = null;
        editForm = null;
        // Reassigned by the next edit row's render; cleared so focus never targets a disposed row.
        editFields = null;
        confirmingDeleteId = null;
        rowErrorMessage = null;
        focusEditName = false;
    }

    private async Task SaveEditAsync()
    {
        // Same double-click guard as AddAsync.
        if (savingEdit || editingId is not { } productId || editForm is null)
        {
            return;
        }

        errorMessage = null;
        rowErrorMessage = null;
        savingEdit = true;
        // Captured before the await, because the user may switch rows while the call is in flight.
        var edited = editForm;
        var name = edited.Name!.Trim();
        var category = edited.Category!.Value;
        try
        {
            var result = await ProductService.UpdateProductAsync(userId!, productId, edited);
            var stillEditing = editingId == productId;
            switch (result)
            {
                case UpdateProductResult.Duplicate:
                    if (stillEditing)
                    {
                        rowErrorMessage = $"Produkt „{name}” jest już w kategorii „{ProductLabels.For(category)}”.";
                    }
                    break;
                case UpdateProductResult.NotFound:
                    if (stillEditing)
                    {
                        ClearRowState();
                    }
                    await LoadAsync();
                    errorMessage = "Ten produkt został już usunięty.";
                    break;
                default:
                    if (stillEditing)
                    {
                        ClearRowState();
                    }
                    // The product may have moved section, changed order or crossed the expiry threshold.
                    await LoadAsync();
                    break;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to update product {ProductId}.", productId);
            if (editingId == productId)
            {
                rowErrorMessage = "Nie udało się zapisać zmian. Spróbuj ponownie.";
            }
        }
        finally
        {
            savingEdit = false;
        }
    }

    private async Task DeleteAsync()
    {
        // Same double-click guard as AddAsync.
        if (deleting || confirmingDeleteId is not { } productId)
        {
            return;
        }

        errorMessage = null;
        rowErrorMessage = null;
        deleting = true;
        try
        {
            var result = await ProductService.DeleteProductAsync(userId!, productId);
            if (confirmingDeleteId == productId)
            {
                ClearRowState();
            }

            await LoadAsync();
            if (result == DeleteProductResult.NotFound)
            {
                errorMessage = "Ten produkt został już usunięty.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete product {ProductId}.", productId);
            if (confirmingDeleteId == productId)
            {
                rowErrorMessage = "Nie udało się usunąć produktu. Spróbuj ponownie.";
            }
        }
        finally
        {
            deleting = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The reset form is rendered first, so the input can only be focused after that render.
        if (focusName && addFields is not null)
        {
            focusName = false;
            await addFields.FocusNameAsync();
        }

        // Likewise, the edit row's inputs only exist after the render that switched it into edit mode.
        if (focusEditName && editFields is not null)
        {
            focusEditName = false;
            await editFields.FocusNameAsync();
        }
    }
}
