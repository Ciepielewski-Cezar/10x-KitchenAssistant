@page "/recipes"
@rendermode InteractiveServer
@implements IDisposable

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using KitchenAssistant.Pantry
@using KitchenAssistant.Recipes

@attribute [Authorize]

@inject RecipeService RecipeService
@inject ProductService ProductService
@inject ILogger<RecipeSuggestions> Logger

<PageTitle>Przepisy</PageTitle>

<h1>Przepisy</h1>

@if (loadFailed)
{
    <div class="alert alert-danger" role="alert">Nie udało się wczytać produktów.</div>
}
else
{
    @if (hasProducts == false)
    {
        <p>Najpierw dodaj produkty. <a href="products">Przejdź do swoich produktów</a></p>
    }

    <div class="mb-4">
        <button type="button" class="btn btn-primary" disabled="@(generating || hasProducts != true)" @onclick="GenerateAsync">
            Zaproponuj przepisy
        </button>

        @if (generating)
        {
            <div class="mt-3" role="status">
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                Generuję przepisy… to może potrwać do minuty
            </div>
        }
    </div>

    @if (failed)
    {
        <div class="alert alert-danger d-flex align-items-center" role="alert">
            <span>Nie udało się wygenerować przepisów.</span>
            <button type="button" class="btn btn-outline-danger btn-sm ms-3" disabled="@generating" @onclick="GenerateAsync">Spróbuj ponownie</button>
        </div>
    }

    @if (noneWithinLimits)
    {
        <div class="alert alert-warning" role="alert">
            <p class="mb-2">Żadna propozycja nie mieści się w limitach.</p>
            @if (hiddenCount > 0)
            {
                <p class="mb-2">@ScoreLabels.Hidden(hiddenCount)</p>
            }
            @if (hiddenOverTimeCount > 0 && MealParameters.Default.MaxPrepMinutes is { } alertMaxPrepMinutes)
            {
                <p class="mb-2">@ScoreLabels.HiddenOverTime(hiddenOverTimeCount, alertMaxPrepMinutes)</p>
            }
            <p class="mb-2">Spróbuj ponownie, zmień parametry albo dodaj produkty.</p>
            <div class="d-flex flex-wrap align-items-center gap-3">
                <button type="button" class="btn btn-warning btn-sm" disabled="@generating" @onclick="GenerateAsync">Spróbuj ponownie</button>
                <a href="products" class="alert-link">Przejdź do swoich produktów</a>
            </div>
        </div>
    }

    @if (proposals is not null)
    {
        @* A new batch never reuses a card (so it renders collapsed): RecipeProposal's lists compare by reference, so keys are
           unique within a batch and never match across batches. Revisit if RecipeProposal gets value-equal collections. *@
        @foreach (var proposal in proposals)
        {
            <RecipeCard @key="proposal" Proposal="proposal" />
        }

        @if (hiddenCount > 0)
        {
            <p class="text-body-secondary">@ScoreLabels.Hidden(hiddenCount)</p>
        }

        @if (hiddenOverTimeCount > 0 && MealParameters.Default.MaxPrepMinutes is { } maxPrepMinutes)
        {
            <p class="text-body-secondary">@ScoreLabels.HiddenOverTime(hiddenOverTimeCount, maxPrepMinutes)</p>
        }
    }
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    // Cancelled when the user leaves the page, so a running generation stops with it.
    private readonly CancellationTokenSource cts = new();
    private string? userId;
    private bool? hasProducts;
    private bool loadFailed;
    private bool generating;
    private bool failed;
    private bool noneWithinLimits;
    private IReadOnlyList<RecipeProposal>? proposals;
    private int hiddenCount;
    private int hiddenOverTimeCount;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask!;
        userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        try
        {
            var products = await ProductService.GetProductsAsync(userId!, cts.Token);
            hasProducts = products.UseFirst.Count + products.Stored.Count > 0;
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            // The user left the page; nothing to render.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load products for recipe suggestions.");
            loadFailed = true;
        }
    }

    private async Task GenerateAsync()
    {
        // The button is only disabled once the render reaches the browser, so a fast double click can still get here twice.
        if (generating)
        {
            return;
        }

        generating = true;
        failed = false;
        noneWithinLimits = false;
        proposals = null;
        hiddenCount = 0;
        hiddenOverTimeCount = 0;
        try
        {
            var result = await RecipeService.GenerateAsync(userId!, MealParameters.Default, cts.Token);
            switch (result.Status)
            {
                case RecipeGenerationStatus.Succeeded:
                    proposals = result.Proposals;
                    hiddenCount = result.HiddenCount;
                    hiddenOverTimeCount = result.HiddenOverTimeCount;
                    break;
                case RecipeGenerationStatus.NoneWithinLimits:
                    noneWithinLimits = true;
                    hiddenCount = result.HiddenCount;
                    hiddenOverTimeCount = result.HiddenOverTimeCount;
                    break;
                case RecipeGenerationStatus.NoProducts:
                    // The products were removed after the page loaded.
                    hasProducts = false;
                    break;
                default:
                    failed = true;
                    break;
            }
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            // The user left the page; nothing to render.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to generate recipes.");
            failed = true;
        }
        finally
        {
            generating = false;
        }
    }

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }
}
